# ============================================================
# SiCure Backend — Local Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your setup.
#   cp .env.local .env
# ============================================================

# ── Database ──────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:@localhost:5432/sicure_db

# ── JWT Authentication ────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET & JWT_REFRESH_SECRET to strong random strings in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=wqkQBqczr_2KWNuG4KmthhmmEUyGmzakyyW87b23xBdxIEwgQUEgoszDmXF9Ks3gxeg2_rQrjfg2C0Dkp5EjIQ
JWT_REFRESH_SECRET=cP-jUgupwiULt3ZGyRKEQUFRkyvoz4B9z06cgPmpLZ4tWZX2ZV5GMHDHDERcX0SHua0jtjfzrtAZxCbsUDPWtg
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this to your actual frontend domain(s).
ALLOWED_ORIGINS=http://localhost:5173

# ── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ── Environment ───────────────────────────────────────────────
# Set to "production" to enable stricter CORS and upload size enforcement.
APP_ENV=development
