# ============================================================
# SiCure Backend — Local Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your setup.
#   cp .env.local .env
# ============================================================

# ── Database ──────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:@localhost:5432/sicure_db

# ── JWT Authentication ────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET to a strong random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this to your actual frontend domain(s).
ALLOWED_ORIGINS=http://localhost:5173

# ── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ── Environment ───────────────────────────────────────────────
# Set to "production" to enable stricter CORS and upload size enforcement.
APP_ENV=development
