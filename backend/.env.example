# ============================================================
# SiCure Backend — Environment Variables
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sicure_db

# JWT Authentication
# IMPORTANT: Generate strong secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Vendor Quote rules
# QUOTE_THRESHOLD: nilai PR (Rp) yang menentukan jumlah minimal penawaran vendor.
#   total > threshold  -> minimal 3 vendor
#   total <= threshold -> minimal 1 vendor
QUOTE_THRESHOLD=5000000
MIN_VENDOR_ABOVE_THRESHOLD=3
MIN_VENDOR_AT_OR_BELOW_THRESHOLD=1

# Environment: "development" or "production"
APP_ENV=development
