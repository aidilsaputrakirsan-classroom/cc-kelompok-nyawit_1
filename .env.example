# ============================================================
# SiCure - Complete Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Database Configuration ──────────────────────────────────
POSTGRES_DB=sicure_db
POSTGRES_USER=sicure_user
POSTGRES_PASSWORD=change_me_strong_password
DB_PORT=5432

# ── Backend Configuration ───────────────────────────────────
BACKEND_PORT=8000
JWT_SECRET=generate_with_python_secrets_token_urlsafe_64
JWT_REFRESH_SECRET=generate_with_python_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
APP_ENV=development

# Database Migration & Seeding (Docker)
# Migration runs automatically on container startup
# Seeding is disabled by default (safe - preserves all data)
SEED_ON_STARTUP=false              # Set to true ONLY for first setup
FORCE_SEED=false                   # Set to true to wipe demo data and re-seed

# ── Frontend Configuration ──────────────────────────────────
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Docker Hub Configuration ────────────────────────────────
# Your Docker Hub username (required for build-and-push)
# Sign up at: https://hub.docker.com/
DOCKER_HUB_USERNAME=your_dockerhub_username
