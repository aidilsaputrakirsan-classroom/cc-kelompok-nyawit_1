# ══════════════════════════════════════════════════════════════════
# Environment Variables untuk Microservices Architecture
# Copy file ini ke .env lalu sesuaikan nilainya
# ══════════════════════════════════════════════════════════════════

# ── Database Passwords ────────────────────────────────────────────
AUTH_DB_PASSWORD=postgres
PROC_DB_PASSWORD=postgres

# ── JWT Secrets (GANTI di production!) ────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-in-production
REFRESH_SECRET_KEY=dev-refresh-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Upload ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
